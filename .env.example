# Create a copy of this file as .env and complete the steps below.

# All users: SIFT vocabulary tree, needed for vocabulary-tree retrieval or
# sequential loop detection. Download from https://demuc.de/colmap/
VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words256K.bin

# Native environment users must set the paths below.
# Docker users do not need to edit anything below this line.
COLMAP_BIN=/path/to/colmap
# Use a post-v0.5.2 build, ideally upstream commit 6d591a34 or later.
LFS_BIN=/path/to/LichtFeld-Studio
SPLAT_TRANSFORM_BIN=/path/to/splat-transform
# Only needed when ALIKED matching uses vocabulary-tree retrieval or sequential loop detection.
ALIKED_N16ROT_VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words64K_aliked_n16rot.bin
ALIKED_N32_VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words64K_aliked_n32.bin
