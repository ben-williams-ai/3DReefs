# Copy to .env and set local machine-specific paths.

# External tools
COLMAP_BIN=/path/to/colmap
# Use a post-v0.5.2 build, ideally upstream commit 6d591a34 or later.
LFS_BIN=/path/to/LichtFeld-Studio
SPLAT_TRANSFORM_BIN=/path/to/splat-transform

# Required when SIFT matching uses vocabulary-tree retrieval or sequential loop detection.
VOCAB_TREE_PATH=/path/to/vocab_tree.bin
# Required when ALIKED matching uses vocabulary-tree retrieval or sequential loop detection.
ALIKED_N16ROT_VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words64K_aliked_n16rot.bin
ALIKED_N32_VOCAB_TREE_PATH=/path/to/vocab_tree_faiss_flickr100K_words64K_aliked_n32.bin
