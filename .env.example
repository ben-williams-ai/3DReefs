# Copy to .env and set local machine-specific paths.

# External tools
COLMAP_BIN=/path/to/colmap
# Use a post-v0.5.2 build, ideally upstream commit 6d591a34 or later.
LFS_BIN=/path/to/LichtFeld-Studio
SPLAT_TRANSFORM_BIN=/path/to/splat-transform

# Required when the selected SfM matching mode uses vocabulary-tree retrieval.
VOCAB_TREE_PATH=/path/to/vocab_tree.bin
